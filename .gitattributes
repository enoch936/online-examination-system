# Normalize line endings: commit LF, let working tree stay native (CRLF on Windows).
* text=auto

# Source / config / docs -> always store LF in the repo.
*.c   text eol=lf
*.cc  text eol=lf
*.cpp text eol=lf
*.h   text eol=lf
*.css text eol=lf
*.csv text eol=lf
*.env text eol=lf
*.d.ts text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.jsx? text eol=lf
*.md  text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.prisma text eol=lf
*.sh  text eol=lf
*.sql text eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Artifacts that tools regenerate on every build -> keep normalized so they don't churn.
frontend/next-env.d.ts text eol=lf
next-env.d.ts text eol=lf

# Never normalize binaries.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
