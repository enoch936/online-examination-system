# === Docker Compose interpolation variables ================================
# Used by deployment/docker-compose.yml for local macOS/Windows Docker and a
# future single-VPS deployment. Compose reads this file automatically as
# `deployment/.env`.
#
#   cp deployment/.env.example deployment/.env
#   # edit deployment/.env with strong values
#   docker compose -f deployment/docker-compose.yml up --build
#
# NEVER commit `deployment/.env`.
# NOTE: POSTGRES_PASSWORD / REDIS_PASSWORD values must be URL-safe (no `@`, `:`, `/`).

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=oes
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=oes

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=replace_with_strong_redis_password

# --- Public origin the UI is served from ------------------------------------
# http://localhost for local Docker; your https://domain for a VPS.
FRONTEND_URL=http://localhost
# Comma-separated list of browser origins allowed by CORS (defaults to FRONTEND_URL).
CORS_ORIGIN=http://localhost

# --- Initial SUPER_ADMIN bootstrap (backend) ---------------------------------
# Used ONCE by the backend to create the SUPER_ADMIN at first server start
# (backend/src/auth/superadmin.bootstrap.ts). Server-side only — never expose
# via NEXT_PUBLIC_*. The password is bcrypt-hashed before storage and is never
# overwritten on restart. Leave both set; the backend fails fast if a fresh
# database requires them and they are missing.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=