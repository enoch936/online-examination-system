# === Backend runtime environment for Docker Compose =========================
# Loaded into the backend container via the optional env_file in
# deployment/docker-compose.yml. Use this for a real single-VPS deployment.
#
#   cp deployment/.env.production.example deployment/.env.production
#   # edit with your real domain and generated secrets
#
# NEVER commit `deployment/.env.production`.
#
# For pure local testing WITHOUT TLS, set NODE_ENV=development instead of
# production (the app refuses NODE_ENV=production with localhost origins),
# and set COOKIE_SECURE=false / COOKIE_SAME_SITE=lax.

NODE_ENV=production

JWT_ACCESS_SECRET=replace_with_32_plus_random_chars
JWT_REFRESH_SECRET=replace_with_32_plus_random_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auth cookies are httpOnly. With a single domain + TLS: secure=true, lax.
# If the frontend and API are on different sites, use none (requires secure).
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_PATH=/

SWAGGER_ENABLED=false
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
DB_POOL_SIZE=20

# Initial SUPER_ADMIN bootstrap (created only once, at first server start, via
# backend/src/auth/superadmin.bootstrap.ts). Values must be strong and are read
# server-side only — never committed, never through NEXT_PUBLIC_*.
# Set SUPERADMIN_EMAIL and SUPERADMIN_PASSWORD to real values (no defaults!).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=