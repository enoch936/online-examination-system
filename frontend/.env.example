# Frontend environment. Copy to `.env.local` for local development:
#   cp frontend/.env.example frontend/.env.local
#
# NEXT_PUBLIC_* values are inlined INTO the client bundle at build time.
# On Vercel, set them in the Vercel project settings (Environment Variables)
# BEFORE building.
#
# API proxying: the app now calls the same-origin path /api/v1 and
# next.config.mjs rewrites /api/:path* to the backend. NEXT_PUBLIC_API_URL is
# used ONLY to compute the rewrite proxy target (any path suffix is stripped,
# only the origin is used). WebSocket traffic is NOT proxied — it connects
# directly to NEXT_PUBLIC_SOCKET_URL. This keeps the backend's host-only
# httpOnly access_token/refresh_token cookies functional.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000/realtime
# Canonical site URL (used by robots.txt + sitemap.xml).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (optional in dev). Leaving the site key unset disables
# the widget; the backend also fails open when TURNSTILE_SECRET_KEY is unset.
# Set both in production to enforce a captcha on login/register:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=<from Cloudflare dashboard>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional WebRTC ICE configuration (comma-separated lists).
# Defaults to public Google/Mozilla STUN servers when unset.
# For restrictive corporate networks configure a TURN server:
# NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# NEXT_PUBLIC_TURN_URL=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=