generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Prisma CLI (migrate) uses this direct connection when the runtime
  // DATABASE_URL is pooled (e.g. Neon pgBouncer). Falls back cleanly when
  // unset only if not referenced — set DIRECT_DATABASE_URL wherever
  // migrations run (CI / Render pre-deploy command).
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  LIVE
  CLOSED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  ESSAY
  MATCHING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum QuestionBankStatus {
  DRAFT
  PUBLISHED
}

enum SessionStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
  FLAGGED
}

enum SubmissionStatus {
  SUBMITTED
  AUTO_SUBMITTED
  NEEDS_MANUAL_GRADING
  GRADED
  PUBLISHED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  EXAM_REMINDER
  RESULT_PUBLISHED
  SYSTEM
}

enum ViolationType {
  TAB_SWITCH
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY_PASTE
  MULTIPLE_FACE_READY
  NO_FACE_READY
  HEARTBEAT_MISSED
  NETWORK_INTERRUPTION
  MANUAL_FLAG
}

enum ConnectionState {
  CONNECTED
  DISCONNECTED
  RECONNECTING
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExamPermissionLevel {
  VIEWER
  MONITOR
  PROCTOR
  CO_OWNER
}

enum ExamEventType {
  EXAM_STARTED
  EXAM_RESUMED
  QUESTION_VIEWED
  QUESTION_ANSWERED
  QUESTION_FLAGGED
  TAB_SWITCHED
  WINDOW_BLURRED
  WINDOW_FOCUSED
  FULLSCREEN_EXITED
  FULLSCREEN_ENTERED
  COPY_ATTEMPT
  PASTE_ATTEMPT
  CUT_ATTEMPT
  PRINT_ATTEMPT
  CONTEXT_MENU_ATTEMPT
  SHORTCUT_ATTEMPT
  CAMERA_CONNECTED
  CAMERA_DISCONNECTED
  MIC_CONNECTED
  MIC_DISCONNECTED
  FACE_DETECTED
  FACE_NOT_DETECTED
  MULTIPLE_FACES_DETECTED
  MOTION_DETECTED
  AUDIO_ACTIVITY
  AI_SIGNAL
  MANUAL_FLAG
  CONNECTION_LOST
  CONNECTION_RESTORED
  EXAM_SUBMITTED
  PAUSED
  RESUMED
  TIME_EXTENDED
  FORCE_SUBMITTED
  SESSION_DISCONNECTED
  WARNING_SENT
  NOTE_ADDED
}

model User {
  id              String          @id @default(uuid()) 
  tenantId        String?         
  email           String          @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  status          UserStatus      @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  roles           UserRole[]
  refreshTokens   RefreshToken[]
  createdExams    Exam[]          @relation("ExamCreator")
  createdQuestions Question[]     @relation("QuestionCreator")
  createdQuestionBanks QuestionBank[] @relation("QuestionBankCreator")
  sessions        ExamSession[]   @relation("StudentSessions")
  examAssignments ExamAssignment[] @relation("ExamAssignments")
  answers         StudentAnswer[] @relation("AnswerGrader")
  notifications   Notification[]
  activityLogs    ActivityLog[]   @relation("ActorActivity")
  auditLogs        AuditLog[]      @relation("ActorAudit")
  examEvents      ExamEvent[]     @relation("StudentEvents")
  acknowledgedExamEvents ExamEvent[] @relation("ExamEventAcknowledger")
  sharedExams     ExamShare[]     @relation("ExamSharedInstructor")
  grantedExamShares ExamShare[]   @relation("ExamShareGranter")

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) 
  name            RoleName         @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  users           UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) 
  key             String           @unique
  label           String
  module          String
  createdAt       DateTime         @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     
  permissionId String     
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String 
  roleId String 
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Subject {
  id          String     @id @default(uuid()) 
  tenantId    String?    
  code        String
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  courses     Course[]
  questions   Question[]
  questionBanks QuestionBank[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("subjects")
}

model Course {
  id          String   @id @default(uuid()) 
  tenantId    String?  
  subjectId   String   
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject       Subject  @relation(fields: [subjectId], references: [id])
  exams         Exam[]
  questionBanks QuestionBank[]
  examCourses   ExamCourse[]

  @@unique([tenantId, code])
  @@index([subjectId])
  @@map("courses")
}

model Exam {
  id                  String          @id @default(uuid()) 
  tenantId            String?         
  courseId            String          
  questionBankId      String?
  createdById         String          
  title               String
  slug                String          @unique
  description         String?
  instructions        String?
  durationMinutes     Int
  totalMarks          Decimal
  passingMarks        Decimal
  negativeMarkingRate Decimal         @default(0)
  attemptsAllowed     Int             @default(1)
  randomizeQuestions  Boolean         @default(true)
  randomizeOptions    Boolean         @default(true)
  fullscreenRequired  Boolean         @default(true)
  showResultImmediately Boolean       @default(false)
  startsAt            DateTime
  endsAt              DateTime
  status              ExamStatus      @default(DRAFT)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  course              Course          @relation(fields: [courseId], references: [id])
  questionBank        QuestionBank?   @relation(fields: [questionBankId], references: [id])
  createdBy           User            @relation("ExamCreator", fields: [createdById], references: [id])
  questions           ExamQuestion[]
  sessions            ExamSession[]
  assignments         ExamAssignment[]
  results             Result[]
  courses             ExamCourse[]
  questionBanks       ExamQuestionBank[]
  events              ExamEvent[]
  monitoringConfig    ExamMonitoringConfig?
  shares              ExamShare[]

  @@index([tenantId])
  @@index([courseId])
  @@index([createdById])
  @@index([status, startsAt, endsAt])
  @@map("exams")
}

model ExamShare {
  id              String             @id @default(uuid())
  examId          String
  instructorId    String
  permissionLevel ExamPermissionLevel @default(VIEWER)
  grantedById     String
  createdAt       DateTime           @default(now())

  exam       Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  instructor User @relation("ExamSharedInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  grantedBy  User @relation("ExamShareGranter", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([examId, instructorId])
  @@index([instructorId])
  @@map("exam_shares")
}

model Question {
  id             String           @id @default(uuid()) 
  tenantId       String?          
  subjectId      String           
  questionBankId String?
  createdById    String           
  type           QuestionType
  difficulty     Difficulty       @default(MEDIUM)
  prompt         String
  explanation    String?
  points         Decimal          @default(1)
  negativePoints Decimal          @default(0)
  tags           String
  topic          String?
  imageUrl       String?
  sortOrder      Int              @default(0)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  subject        Subject          @relation(fields: [subjectId], references: [id])
  questionBank   QuestionBank?    @relation(fields: [questionBankId], references: [id])
  createdBy      User             @relation("QuestionCreator", fields: [createdById], references: [id])
  options        QuestionOption[]
  exams          ExamQuestion[]
  answers        StudentAnswer[]

  @@index([tenantId])
  @@index([subjectId, type, difficulty])
  @@index([questionBankId])
  @@index([type])
  @@index([difficulty])
  @@index([createdAt])
  @@map("questions")
}

model QuestionBank {
  id          String             @id @default(uuid()) 
  tenantId    String?            
  courseId    String             
  categoryId  String             
  createdById String             
  name        String
  description String?
  difficulty  Difficulty?
  status      QuestionBankStatus @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  course      Course             @relation(fields: [courseId], references: [id])
  category    Subject            @relation(fields: [categoryId], references: [id])
  createdBy   User               @relation("QuestionBankCreator", fields: [createdById], references: [id])
  questions   Question[]
  exams       Exam[]
  examBanks   ExamQuestionBank[]

  @@index([tenantId])
  @@index([courseId])
  @@index([categoryId])
  @@index([status])
  @@map("question_banks")
}

model QuestionOption {
  id         String   @id @default(uuid()) 
  questionId String   
  label      String
  text       String
  isCorrect  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
  @@index([questionId])
  @@map("question_options")
}

model ExamQuestion {
  id         String   @id @default(uuid()) 
  examId     String   
  questionId String   
  points     Decimal
  sortOrder  Int      @default(0)

  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
  @@index([questionId])
  @@map("exam_questions")
}

model ExamCourse {
  id       String @id @default(uuid()) 
  examId   String
  courseId String

  exam     Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  course   Course  @relation(fields: [courseId], references: [id])

  @@unique([examId, courseId])
  @@index([courseId])
  @@map("exam_courses")
}

model ExamQuestionBank {
  id             String        @id @default(uuid()) 
  examId         String
  questionBankId String

  exam           Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionBank   QuestionBank  @relation(fields: [questionBankId], references: [id])

  @@unique([examId, questionBankId])
  @@index([questionBankId])
  @@map("exam_question_banks")
}

model ExamAssignment {
  id        String   @id @default(uuid()) 
  examId    String   
  studentId String   
  assignedAt DateTime @default(now())

  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   User     @relation("ExamAssignments", fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([examId])
  @@map("exam_assignments")
}

model ExamSession {
  id               String           @id @default(uuid()) 
  examId           String           
  studentId        String           
  attemptNumber    Int              @default(1)
  status           SessionStatus    @default(NOT_STARTED)
  startedAt        DateTime?
  expiresAt        DateTime?
  submittedAt      DateTime?
  remainingSeconds Int?
  currentQuestionId String?         
  currentQuestionIndex Int?
  questionOrder String?
  optionOrder String?
  metadata String?
  connectionState  ConnectionState  @default(CONNECTED)
  lastHeartbeatAt  DateTime?
  heartbeatCount   Int              @default(0)
  disconnectCount  Int              @default(0)
  lastActivityAt   DateTime?
  riskScore        Int              @default(0)
  riskLevel        RiskLevel        @default(LOW)
  retakePermitted  Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  exam             Exam             @relation(fields: [examId], references: [id])
  student          User             @relation("StudentSessions", fields: [studentId], references: [id])
  answers          StudentAnswer[]
  violations       ExamViolation[]
  activityLogs     ActivityLog[]
  submission       Submission?
  events           ExamEvent[]

  @@unique([examId, studentId, attemptNumber])
  @@index([studentId, status])
  @@index([examId, status])
  @@index([status, expiresAt])
  @@index([connectionState])
  @@index([examId, createdAt])
  @@map("exam_sessions")
}

model StudentAnswer {
  id               String      @id @default(uuid()) 
  sessionId        String      
  questionId       String      
  selectedOptionIds String
  answerText       String?
  answerJson       String?
  isBookmarked     Boolean     @default(false)
  isMarkedForReview Boolean    @default(false)
  savedAt          DateTime    @default(now())
  score            Decimal?
  graderId         String?     
  feedback         String?

  session          ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id])
  grader           User?       @relation("AnswerGrader", fields: [graderId], references: [id])

  @@unique([sessionId, questionId])
  @@index([questionId])
  @@map("student_answers")
}

model Submission {
  id                 String           @id @default(uuid()) 
  sessionId          String           @unique 
  status             SubmissionStatus @default(SUBMITTED)
  submittedAt        DateTime         @default(now())
  autoSubmitted      Boolean          @default(false)
  totalScore         Decimal          @default(0)
  maxScore           Decimal          @default(0)
  percentage         Decimal          @default(0)
  isPassed           Boolean          @default(false)
  gradingCompletedAt DateTime?

  session            ExamSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  result             Result?

  @@index([status, submittedAt])
  @@index([sessionId])
  @@map("submissions")
}

model Result {
  id           String       @id @default(uuid()) 
  submissionId String       @unique 
  examId       String       
  studentId    String       
  score        Decimal
  maxScore     Decimal
  percentage   Decimal
  grade        String?
  passed       Boolean
  feedback     String?
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())

  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  exam         Exam         @relation(fields: [examId], references: [id])
  certificate  Certificate?

  @@index([examId])
  @@index([studentId])
  @@index([percentage])
  @@index([createdAt])
  @@map("results")
}

model Certificate {
  id               String   @id @default(uuid()) 
  resultId         String   @unique 
  certificateNo    String   @unique
  verificationCode String   @unique
  fileUrl          String?
  issuedAt         DateTime @default(now())
  expiresAt        DateTime?

  result           Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model Notification {
  id        String           @id @default(uuid()) 
  userId    String           
  type      NotificationType @default(INFO)
  title     String
  message   String
  readAt    DateTime?
  metadata String?
  createdAt DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id            String       @id @default(uuid()) 
  actorId       String?      
  examSessionId String?      
  action        String
  ipAddress     String?
  userAgent     String?
  metadata String?
  createdAt     DateTime     @default(now())

  actor         User?        @relation("ActorActivity", fields: [actorId], references: [id])
  examSession   ExamSession? @relation(fields: [examSessionId], references: [id])

  @@index([actorId, createdAt])
  @@index([examSessionId, createdAt])
  @@map("activity_logs")
}

model AuditLog {
  id        String   @id @default(uuid()) 
  actorId   String?  
  action    String
  entity    String
  entityId  String?
  before String?
  after String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor     User?    @relation("ActorAudit", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid()) 
  userId    String    
  tokenHash String
  jti       String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userAgent String?
  ipAddress String?
  lastUsedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, jti])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("refresh_tokens")
}

model ContactMessage {
  id        String    @id @default(uuid())
  name      String
  email     String
  message   String
  status    String    @default("NEW")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model PlatformSetting {
  key       String    @id
  value     String
  isPublic  Boolean   @default(false)
  updatedAt DateTime  @updatedAt

  @@map("platform_settings")
}

model ExamViolation {
  id        String        @id @default(uuid()) 
  sessionId String        
  type      ViolationType
  severity  Int           @default(1)
  details String?
  occurredAt DateTime     @default(now())

  session   ExamSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt])
  @@index([occurredAt])
  @@map("exam_violations")
}

model ExamEvent {
  id              String        @id @default(uuid())
  examId          String
  sessionId       String
  studentId       String
  type            ExamEventType
  timestamp       DateTime      @default(now())
  metadata        String?
  riskScore       Int           @default(0)
  severity        RiskLevel     @default(LOW)
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  note            String?
  createdAt       DateTime      @default(now())

  exam            Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  session         ExamSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student         User          @relation("StudentEvents", fields: [studentId], references: [id])
  acknowledgedByUser User?      @relation("ExamEventAcknowledger", fields: [acknowledgedBy], references: [id])

  @@index([examId, timestamp])
  @@index([sessionId, timestamp])
  @@index([studentId, timestamp])
  @@index([type])
  @@index([type, timestamp])
  @@map("exam_events")
}

model ExamMonitoringConfig {
  id                  String   @id @default(uuid())
  examId              String   @unique
  webcamEnabled       Boolean  @default(false)
  micEnabled          Boolean  @default(false)
  screenMonitoring    Boolean  @default(false)
  recordingEnabled    Boolean  @default(false)
  aiDetectionEnabled  Boolean  @default(false)
  eventLoggingEnabled Boolean  @default(true)
  requireConsent      Boolean  @default(true)
  weights             String   @default("{}")
  thresholds          String   @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  exam                Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_monitoring_configs")
}





