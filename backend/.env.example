NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Browser origins allowed by REST CORS. Comma-separated list.
# In production this MUST be the public https origin(s) of the frontend.
FRONTEND_URL=http://localhost:3000
# Socket.IO gateway origins. Falls back to FRONTEND_URL when unset.
CORS_ORIGIN=http://localhost:3000

# Runtime (pooled) Postgres connection, e.g. Neon pooler URL.
DATABASE_URL=postgresql://oes:oes_password@localhost:5432/oes?schema=public
# Direct connection used ONLY by Prisma migrate (required on Render/CI).
DIRECT_DATABASE_URL=postgresql://oes:oes_password@localhost:5432/oes?schema=public

JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auth cookies (all httpOnly). Production defaults: secure=true.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/

SWAGGER_ENABLED=true
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
