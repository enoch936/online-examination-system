# Backend environment. Copy to `.env` for local development:
#   cp backend/.env.example backend/.env
#
# Values below are LOCAL DEVELOPMENT defaults only. Never use them in
# production — Render/Vercel/Neon/Redis Cloud supply real secrets there.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=api/v1

# Browser origins allowed by REST CORS. Comma-separated list.
# In production this MUST be the public https origin(s) of the frontend.
FRONTEND_URL=http://localhost:3000
# Socket.IO gateway origins. Falls back to FRONTEND_URL when unset.
CORS_ORIGIN=http://localhost:3000

# Runtime (pooled) Postgres connection, e.g. Neon pooler URL.
DATABASE_URL=postgresql://oes:local_dev_password_here@localhost:5432/oes?schema=public
# Direct connection used ONLY by Prisma migrate (required on Render/CI).
DIRECT_DATABASE_URL=postgresql://oes:local_dev_password_here@localhost:5432/oes?schema=public

# Redis (optional in development). When unset, caching and background queues
# run in no-op mode and Socket.IO runs single-process.
REDIS_URL=
# REDIS_URL fallback when only host/port/password are provided:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auth cookies (all httpOnly). Production defaults: secure=true, sameSite none
# when the frontend and API are on different sites.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/

SWAGGER_ENABLED=true
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
DB_POOL_SIZE=20

# Initial SUPER_ADMIN bootstrap credentials. Read ONLY on the server side when
# the app starts and no SUPER_ADMIN exists yet (see backend/src/auth/superadmin.bootstrap.ts).
# The password is hashed with bcrypt before storage and is NEVER persisted in
# plaintext, returned by any API, or logged. Never commit real values here and
# never expose them through NEXT_PUBLIC_* variables.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=